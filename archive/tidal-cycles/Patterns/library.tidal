-- Reusable pattern library
-- Import ideas here as you develop them

-- ─── RHYTHMS ─────────────────────────────────────────────────

-- Four on the floor
-- d1 $ s "bd*4"

-- Classic breakbeat
-- d1 $ s "bd ~ ~ bd ~ ~ sn ~"

-- Jungle
-- d1 $ s "bd*2 ~ [bd bd] ~" # speed 1.5

-- ─── CHORDS ──────────────────────────────────────────────────

-- Minor chord stack
-- d2 $ note "[0,3,7]" # s "superpiano"

-- Progression: i - VI - III - VII
-- d2 $ note "<[0,3,7] [-5,-2,2] [-4,-1,3] [-7,-4,0]>" # s "superpiano"

-- ─── EFFECTS ─────────────────────────────────────────────────

-- Room verb
-- # room 0.4 # sz 0.8

-- Filter sweep
-- # lpf (slow 4 $ range 200 8000 sine)

-- Stutter
-- jux (iter 4)

-- ─── UTILITY ─────────────────────────────────────────────────

-- Slow everything down
-- setcps (80/120)  -- 80 bpm

-- Speed up
-- setcps (140/120)  -- 140 bpm
